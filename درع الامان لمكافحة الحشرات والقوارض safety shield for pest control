        .btn-warning:hover {
            background: var(--brand-gold-hover);
            border-color: var(--brand-gold-hover);
            transform: translateY(-2px);
        }

        .btn-primary {
            background: var(--brand-dark);
            border-color: var(--brand-dark);
            font-weight: 700;
            padding: 12px 32px;
            border-radius: 50px;
            transition: var(--transition-smooth);
