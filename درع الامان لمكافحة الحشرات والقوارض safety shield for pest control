            border: none;
            border-radius: 16px;
            overflow: hidden;
            background: white;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            transition: var(--transition-smooth);
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .card-pest:hover {
