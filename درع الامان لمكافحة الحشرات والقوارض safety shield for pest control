            text-align: center;
            padding: 8px 0;
            font-size: 0.95rem;
            position: relative;
            z-index: 1030;
        }

        /* --- NAVBAR --- */
        .navbar {
            background: linear-gradient(135deg, var(--brand-dark), var(--brand-deep));
            padding: 15px 0;
            transition: var(--transition-smooth);
        }

        .navbar.scrolled {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.3rem;
        }

        /* --- HERO SECTION --- */
        .hero-section {
            position: relative;
            min-height: 85vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
            background: url('https://i.ibb.co/RGpCFM9q/image.jpg') center/cover no-repeat fixed;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: rgba(10, 25, 45, 0.8);
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 800px;
            padding: 20px;
        }

        .hero-logo {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 50%;
            background: white;
            padding: 8px;
            margin-bottom: 25px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            border: 3px solid rgba(255, 255, 255, 0.2);
        }

        .hero-title {
            font-weight: 800;
            font-size: 3rem;
            margin-bottom: 15px;
        }

        .hero-lead {
            font-size: 1.4rem;
            opacity: 0.9;
            margin-bottom: 30px;
        }

        /* --- TRUST BAR --- */
        .trust-bar-container {
            margin-top: -40px;
            position: relative;
            z-index: 10;
        }

        .trust-bar {
            background: white;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }

        .trust-item {
            font-weight: 700;
            color: var(--brand-dark);
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .trust-item i {
            color: #28a745;
        }

        /* --- SECTIONS --- */
        section {
            padding: 80px 0;
        }

        .section-title {
            font-weight: 800;
            color: var(--brand-dark);
            text-align: center;
            margin-bottom: 45px;
            position: relative;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 4px;
            background: var(--brand-gold);
            border-radius: 2px;
        }

        /* --- WHY US CARDS (NEW) --- */
        .why-card {
            background: white;
            border-radius: 16px;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
            border: 1px solid #eef1f5;
            transition: var(--transition-smooth);
            height: 100%;
        }

        .why-card:hover {
            transform: translateY(-5px);
            border-color: var(--brand-gold);
            box-shadow: 0 10px 25px rgba(15, 45, 74, 0.08);
        }

        .why-icon {
            width: 60px;
            height: 60px;
            line-height: 60px;
            background: rgba(15, 45, 74, 0.05);
            color: var(--brand-dark);
            border-radius: 50%;
            font-size: 1.5rem;
            margin-bottom: 20px;
            display: inline-block;
            transition: var(--transition-smooth);
        }

        .why-card:hover .why-icon {
            background: var(--brand-dark);
            color: white;
        }

        /* --- STATS --- */
        .stats {
            background: var(--brand-dark);
            color: white;
            padding: 50px 0;
            text-align: center;
        }

        .stat-box {
            font-size: 1.3rem;
            font-weight: 700;
            padding: 15px;
        }

        .stat-box i {
            color: var(--brand-gold);
            margin-bottom: 10px;
            font-size: 1.8rem;
            display: block;
        }

